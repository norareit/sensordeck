# Gives the user of the active session access to the SmartMonitor screen, USB ID 0483:0065, through hidraw.
# The uaccess tag is acted on by 73-seat-late.rules, so this file must sort before that name.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="0065", MODE="0660", TAG+="uaccess"

# Gives the same access to the Corsair iCUE Commander Core XT, USB ID 1b1c:0c2a, whose temperature probes sensordeck reads and whose LEDs it lights.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="0c2a", MODE="0660", TAG+="uaccess"

# Lets the kernel suspend the SmartMonitor screen when no program holds it open. A suspend and resume clears the hang of
# its firmware after a USB reset, which sensordeck run relies on to recover it. The delay is set before the control.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0483", ATTR{idProduct}=="0065", ATTR{power/autosuspend_delay_ms}="2000", ATTR{power/control}="auto"
